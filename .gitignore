# Dependencies
node_modules/

# Build output
dist/

# Bun
bun.lockb

# OS files
.DS_Store

# Editor
.vscode/
.idea/
.claude/

# Test coverage
coverage/

# Design docs / working artifacts (local only, not for origin)
devdocs/

# Project-local veda session artifacts (created when tests/veda run in this repo)
.veda/

# Stale docs (superseded by README.md and devdocs/)
# docs/veda.md is tracked — the onboarding doc synced to ~/.pi/agent/docs by
# 'veda skills install' and referenced by every skill.
docs/*
!docs/veda.md

# Legacy prompt templates (superseded by .agents/skills/)
prompts/

# Cross-compiled platform binaries (build artifacts, ~60MB each)
platform/*/bin/
