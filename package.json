{
  "name": "veda-ts",
  "version": "0.72.2",
  "description": "Pair your driving AI agent with a CLI-based navigator agent from codex, claude, or pi.",
  "type": "module",
  "license": "MIT",
  "author": "kennyfrc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennyfrc/veda.git",
    "directory": "veda-ts"
  },
  "homepage": "https://github.com/kennyfrc/veda/tree/master/veda-ts",
  "bugs": {
    "url": "https://github.com/kennyfrc/veda/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "agent",
    "pair-programming",
    "navigator",
    "deep-thinking",
    "codex",
    "claude",
    "llm",
    "code-review"
  ],
  "bin": {
    "veda": "bin/veda.cjs"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "veda-ts-darwin-arm64": "0.72.0",
    "veda-ts-darwin-x64": "0.72.0",
    "veda-ts-linux-x64": "0.72.0",
    "veda-ts-linux-arm64": "0.72.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build": "bun build --compile --outfile dist/veda src/index.ts",
    "build:platforms": "bash scripts/build-platforms.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
