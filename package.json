{
  "name": "veda-ts",
  "version": "0.9.2",
  "description": "AI CLI wrapper with multi-backend support and deep reasoning",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build": "bun build --compile --outfile dist/veda src/index.ts && ln -sf $(pwd)/dist/veda /usr/local/bin/veda",
    "build:prod": "bun build --compile --minify --outfile dist/veda src/index.ts && ln -sf $(pwd)/dist/veda /usr/local/bin/veda",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
